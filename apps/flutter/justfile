set positional-arguments

@default:
    @just --list

# Clear the build cache
clear:
    flutter clean

# Install dependencies
install:
    flutter pub get

generate:
    flutter pub run build_runner build

# Run the app
run *args:
    # {{ args }}
    flutter run "$@"

build-windows:
    flutter build windows

build-linux:
    flutter build linux

build-android build_name:
    flutter build apk --release --split-per-abi --build-name {{ build_name }}

install-android: (build-android "test")
    adb install -r build/app/outputs/flutter-apk/app-arm64-v8a-release.apk

build-all:
    flutter build linux
    flutter build apk

    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "gh-pages": "^6.3.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sass": "^1.101.0",
    "typescript": "~6.0.3",

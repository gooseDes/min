{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@tests/*": ["./src/__tests__/*"],
      "@mocks/*": ["./src/__mocks__/*"],
    },
  },
  "include": ["src"],
}
